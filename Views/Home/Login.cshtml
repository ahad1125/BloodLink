@model LoginViewModel
@{ ViewData["Title"] = "Log in"; }
<main class="container auth-wrap"><aside class="auth-aside"><span class="eyebrow text-white-50">WELCOME BACK</span><h1 class="display-5 fw-bold mt-3">Good to have you here.</h1><p class="mt-3">Every connection can make a difference. Sign in to pick up where your community needs you.</p><div class="auth-heart">♥</div><p class="small text-white-50 mt-auto mb-0">Your next step could help someone today.</p></aside><section class="auth-form"><span class="eyebrow">YOUR BLOODLINK ACCOUNT</span><h2 class="fw-bold mt-2">Log in</h2><p class="text-secondary mb-4">Enter your details to continue.</p><form asp-action="Login" method="post">
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control form-control-lg mb-3" placeholder="you@example.com" autocomplete="username" /><span asp-validation-for="Email" class="text-danger small"></span>
<label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control form-control-lg" placeholder="Enter your password" autocomplete="current-password" /><span asp-validation-for="Password" class="text-danger small"></span>
<input asp-for="ReturnUrl" type="hidden" />
<div class="form-check my-3"><input asp-for="RememberMe" class="form-check-input" /><label asp-for="RememberMe" class="form-check-label small">Remember me</label></div>
<button class="btn btn-danger btn-lg w-100 rounded-pill" type="submit">Log in →</button></form><p class="small text-center mt-4 mb-0">New to BloodLink? <a class="text-danger fw-semibold" asp-action="Register">Create an account</a></p><p class="prototype-note mt-4">Sign in with the email and password you used to register. Dashboard access follows your account role.</p></section></main>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
