@{ ViewData["Title"] = "Requester workspace"; }
<div class="container py-5"><span class="eyebrow">REQUESTER HOME</span><h1 class="h2 fw-bold mt-2">Let’s find the help you need, @ViewData["DisplayName"].</h1><p class="text-secondary">Create a request or check the progress of an existing one.</p><section class="content-card mb-4"><h2 class="h5 fw-bold">Post a blood request</h2><form method="post" asp-action="RequestBlood"><div class="row g-3"><div class="col-sm-6"><label class="form-label" for="bloodGroup">Blood group</label><select id="bloodGroup" name="bloodGroup" class="form-select" required><option value="">Select group</option>@foreach(var g in new[]{"A+","A-","B+","B-","AB+","AB-","O+","O-"}){<option>@g</option>}</select></div><div class="col-sm-6"><label class="form-label" for="units">Units needed</label><input id="units" name="units" type="number" class="form-control" min="1" max="20" required /></div><div class="col-12"><label class="form-label" for="hospital">Hospital</label><input id="hospital" name="hospital" class="form-control" maxlength="160" required /></div><div class="col-12"><button class="btn btn-danger rounded-pill" type="submit">Submit request →</button></div></div></form></section><section class="content-card"><h2 class="h5 fw-bold">Your requests</h2>@if (ViewBag.Requests is System.Collections.Generic.List<Web_Project.Models.BloodRequest> requests && requests.Count > 0){<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Blood</th><th>Units</th><th>Hospital</th><th>Status</th><th>Submitted</th></tr></thead><tbody>@foreach(var request in requests){<tr><td>@request.BloodGroup</td><td>@request.Units</td><td>@request.Hospital</td><td>@request.Status</td><td>@request.CreatedAtUtc.ToLocalTime().ToString("g")</td></tr>}</tbody></table></div>}else{<p class="text-secondary mb-0">No requests yet. Your submissions will show here.</p>}</section></div>
