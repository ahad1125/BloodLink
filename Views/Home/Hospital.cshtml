@{ ViewData["Title"] = "Hospital workspace"; }
<div class="container py-5"><span class="eyebrow">HOSPITAL / BLOOD BANK HOME</span><h1 class="h2 fw-bold mt-2">Donation coordination</h1><p class="text-secondary">Review incoming requests and confirm completed donations.</p><div class="row g-3 my-3">@foreach(var item in new[]{("Requests to review","03"),("Donations today","05"),("Completed this month","24")}){<div class="col-sm-4"><div class="metric-card"><span>@item.Item1</span><strong>@item.Item2</strong></div></div>}</div><section class="content-card"><h2 class="h5 fw-bold">Requests needing attention</h2><p class="text-secondary">Review request details and confirm donations after they take place.</p><div class="request-row"><span class="blood-badge">O+</span><div><strong>City Care Hospital</strong><div class="small text-secondary">2 units · Urgent</div></div><span class="badge text-bg-warning ms-auto">Donor accepted</span></div></section></div>
