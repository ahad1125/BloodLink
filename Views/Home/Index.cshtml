@{ ViewData["Title"] = "Give blood. Give hope."; }
<section class="hero"><div class="container py-5"><div class="row align-items-center g-5 py-lg-5"><div class="col-lg-6"><span class="eyebrow"><span class="pulse-dot"></span>A community that shows up</span><h1 class="display-3 fw-bold mt-4">A few moments.<br><span class="text-danger">A lifetime</span> for someone.</h1><p class="lead text-secondary mt-4">Find blood donors nearby, request help when it matters, and keep every donation moving toward a life saved.</p><div class="d-flex flex-wrap gap-3 mt-4"><a class="btn btn-danger btn-lg rounded-pill px-4" asp-action="Register">Join the community →</a><a class="btn btn-outline-dark btn-lg rounded-pill px-4" asp-action="Login">I need blood</a></div><div class="d-flex gap-4 mt-5 small text-secondary"><span><strong class="text-dark">Local</strong> donor matching</span><span><strong class="text-dark">Clear</strong> request tracking</span><span><strong class="text-dark">Verified</strong> donation journey</span></div></div><div class="col-lg-6"><div class="hero-card"><div class="hero-orbit orbit-one"></div><div class="hero-orbit orbit-two"></div><div class="blood-drop">♥</div><div class="float-card card-top"><span class="mini-icon">✚</span><div><strong>Request matched</strong><small>Donors in your city notified</small></div><span class="status-dot"></span></div><div class="float-card card-bottom"><div class="avatar-stack"><i>AK</i><i>SA</i><i>+</i></div><div><strong>People are ready to help</strong><small>One community. Countless lives.</small></div></div><div class="hero-caption">Give what you can. Be there when it counts.</div></div></div></div></div></section>
<section class="py-5" id="how"><div class="container py-3"><div class="section-heading text-center"><span class="eyebrow">THE JOURNEY</span><h2 class="fw-bold mt-2">Help moves one step at a time.</h2><p class="text-secondary">From a request to a confirmed donation, everyone knows what happens next.</p></div><div class="row g-4 mt-4"><div class="col-md-4"><article class="step-card"><span class="step-num">01</span><h3>Ask for help</h3><p>Share blood group, hospital, units needed, and how urgent it is.</p></article></div><div class="col-md-4"><article class="step-card"><span class="step-num">02</span><h3>Meet a nearby donor</h3><p>Matching donors in the same city can respond to the request.</p></article></div><div class="col-md-4"><article class="step-card"><span class="step-num">03</span><h3>Confirm the donation</h3><p>The hospital verifies the donation and the request is completed.</p></article></div></div></div></section>
<section class="roles-section py-5" id="roles"><div class="container py-3"><div class="row align-items-end mb-4"><div class="col-md-8"><span class="eyebrow">ONE PLATFORM, FOUR WAYS TO HELP</span><h2 class="fw-bold mt-2">There’s a place for you here.</h2></div><div class="col-md-4 text-md-end"><a class="text-danger fw-semibold" asp-action="Register">Create your account →</a></div></div><div class="row g-3">
@foreach (var role in new[] { (Name: "Donor", Icon: "♥", Style: "red", Copy: "Set availability, respond to requests, and track donations."), (Name: "Requester", Icon: "＋", Style: "peach", Copy: "Post a blood request and follow its progress."), (Name: "Hospital", Icon: "✚", Style: "blue", Copy: "Review requests and confirm completed donations."), (Name: "Administrator", Icon: "⌘", Style: "dark", Copy: "Approve facilities and monitor the network.") })
{<div class="col-md-6 col-lg-3"><a class="role-card" asp-action="Dashboard" asp-route-role="@role.Name"><span class="role-icon @role.Style">@role.Icon</span><h3>@role.Name</h3><p>@role.Copy</p><span>Explore @role.Name.ToLower() home →</span></a></div>}
</div></div></section>
<section class="cta-section"><div class="container py-5"><div class="cta-panel d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-4"><div><span class="eyebrow text-white-50">BE SOMEONE’S REASON TO HOPE</span><h2 class="fw-bold mt-2 mb-0">Ready when you are.</h2></div><a class="btn btn-light btn-lg rounded-pill px-4 text-danger fw-semibold" asp-action="Register">Get started →</a></div></div></section>
