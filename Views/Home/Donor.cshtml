@{ ViewData["Title"] = "Donor workspace"; }
<div class="container py-5"><span class="eyebrow">DONOR HOME</span><h1 class="h2 fw-bold mt-2">Good to have you here, @ViewData["DisplayName"] <span aria-hidden="true">✦</span></h1><p class="text-secondary">Your availability can be someone’s lifeline.</p><div class="alert alert-soft">♥ &nbsp; Your profile helps matching requests find you.</div><div class="row g-3 my-3">@foreach(var item in new[]{("Blood group",ViewData["BloodGroup"]?.ToString() ?? "Not set"),("Your city",ViewData["City"]?.ToString() ?? "Not set")}){<div class="col-sm-6"><div class="metric-card"><span>@item.Item1</span><strong>@item.Item2</strong></div></div>}</div><section class="content-card"><h2 class="h5 fw-bold">Nearby requests</h2><p class="text-secondary">Matching requests can be connected to your donor account.</p></section></div>
