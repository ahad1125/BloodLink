@model RegisterViewModel
@{ ViewData["Title"] = "Create account"; }
<main class="container auth-wrap signup-wrap"><aside class="auth-aside"><span class="eyebrow text-white-50">JOIN BLOODLINK</span><h1 class="display-5 fw-bold mt-3">Good things happen when we show up.</h1><p class="mt-3">Create an account to connect with local donors and the organizations supporting them.</p><div class="auth-heart">♥</div><p class="small text-white-50 mt-auto mb-0">One shared goal: help people get the blood they need.</p></aside><section class="auth-form"><span class="eyebrow">GET STARTED</span><h2 class="fw-bold mt-2">Create your account</h2><p class="text-secondary mb-4">Tell us a little about yourself.</p><form asp-action="Register" method="post">
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control mb-3" placeholder="Your name" /><span asp-validation-for="FullName" class="text-danger small"></span>
<label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control mb-3" placeholder="you@example.com" autocomplete="email" /><span asp-validation-for="Email" class="text-danger small"></span>
<div class="row"><div class="col-sm-6"><label asp-for="City" class="form-label"></label><input asp-for="City" class="form-control mb-3" placeholder="Your city" /><span asp-validation-for="City" class="text-danger small"></span></div><div class="col-sm-6"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control mb-3" placeholder="Your number" /></div></div>
<label asp-for="Role" class="form-label">I’m joining as a</label><select asp-for="Role" id="signup-role" class="form-select mb-3"><option value="">Select your role</option><option>Donor</option><option>Requester</option><option>Hospital</option></select><span asp-validation-for="Role" class="text-danger small"></span>
<div id="donor-fields" class="mb-3 d-none"><label asp-for="BloodGroup" class="form-label"></label><select asp-for="BloodGroup" class="form-select"><option value="">Select blood group</option><option>A+</option><option>A-</option><option>B+</option><option>B-</option><option>AB+</option><option>AB-</option><option>O+</option><option>O-</option></select></div>
<label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control mb-3" placeholder="At least 8 characters" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger small"></span>
<label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control mb-4" placeholder="Re-enter your password" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
<button class="btn btn-danger w-100 rounded-pill" type="submit">Create account →</button></form><p class="small text-center mt-4 mb-0">Already a member? <a class="text-danger fw-semibold" asp-action="Login">Log in</a></p><p class="prototype-note mt-3">Use at least 8 characters including an uppercase letter, a lowercase letter, and a number.</p></section></main>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script>const roleSelect=document.getElementById('signup-role');const donorFields=document.getElementById('donor-fields');function updateDonorFields(){donorFields.classList.toggle('d-none',roleSelect.value!=='Donor')}roleSelect.addEventListener('change',updateDonorFields);updateDonorFields();</script> }
